{
  "private": true,
  "name": "@pontinho/api",
  "version": "0.1.0",
  "description": "Contas, perfil, carteira e compras do Pontinho",
  "type": "module",
  "main": "build/server.js",
  "engines": {
    "node": ">= 22.18.0"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "start": "node build/server.js",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "clean": "rimraf build",
    "test": "mocha",
    "typecheck": "tsc --noEmit -p .",
    "lint": "eslint .",
    "openapi": "tsx scripts/generate-openapi.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "postinstall": "prisma generate"
  },
  "author": "",
  "license": "UNLICENSED",
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/swagger": "^9.9.3",
    "@fastify/type-provider-zod": "^1.0.3",
    "@pontinho/api-contract": "*",
    "@pontinho/rules": "*",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@supabase/supabase-js": "^2.118.0",
    "fastify": "^5.12.7",
    "jose": "^6.2.15",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.1",
    "dotenv": "^18.0.9",
    "eslint-plugin-no-comments": "^1.2.1",
    "mocha": "^11.7.5",
    "prisma": "^7.10.1",
    "rimraf": "^5.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.0.4"
  }
}
